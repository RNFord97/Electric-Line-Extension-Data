      <aliases enabled='yes' />
      <column aggregation='CountD' caption='New Construction/Upgrade' datatype='string' name='[Calculation_1750492942092722180]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Fuel_Structure_Type], &quot;New Construction&quot;) THEN &quot;New Construction&quot;&#13;&#10;ELSEIF CONTAINS([Fuel_Structure_Type], &quot;Upgrades&quot;) THEN &quot;Upgrades&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Mixed Fuel/All Electric' datatype='string' name='[Calculation_1750492942093090821]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Fuel_Structure_Type], &quot;All Electric&quot;) THEN &quot;All Electric&quot;&#13;&#10;ELSEIF CONTAINS([Fuel_Structure_Type], &quot;Mixed Fuel&quot;) THEN &quot;Mixed Fuel&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='All Electric Count' datatype='real' name='[Calculation_1750492942093598726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1750492942093090821] = &quot;All Electric&quot; AND ([Type] = &quot;Total Electric Line Extension Applications for Applicant Install&quot; OR [Type] = &quot;Total Electric Line Extension Requests Received (Applications)&quot;)&#13;&#10;THEN [Count]&#13;&#10;END' />
      </column>
      <column caption='All + Mixed Count' datatype='real' name='[Calculation_1750492942093725703]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([Calculation_1750492942093090821] = &quot;All Electric&quot; OR [Calculation_1750492942093090821] = &quot;Mixed Fuel&quot;)&#13;&#10;AND ([Type] = &quot;Total Electric Line Extension Applications for Applicant Install&quot; OR [Type] = &quot;Total Electric Line Extension Requests Received (Applications)&quot;)&#13;&#10;THEN [Count]&#13;&#10;END' />
      </column>
      <column caption='Percent All Electric' datatype='real' name='[Calculation_1750492942094143497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1750492942093598726]) / SUM([Calculation_1750492942093725703])*100' />
      </column>
      <column caption='Total ELE Applications' datatype='real' name='[Calculation_2003538916785188864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [Type] = &quot;Total Electric Line Extension Requests Received (Applications)&quot; OR [Type] = &quot;Total Electric Line Extension Applications for Applicant Install&quot; THEN [Count]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Total Electric Line Extensions Energized' datatype='real' name='[Calculation_2003538916790829057]' role='measure' type='quantitative'>
