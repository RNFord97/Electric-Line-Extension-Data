              <calculation class='tableau' formula='IF CONTAINS([Fuel_Structure_Type], &quot;New Construction&quot;) THEN &quot;New Construction&quot;&#13;&#10;ELSEIF CONTAINS([Fuel_Structure_Type], &quot;Upgrades&quot;) THEN &quot;Upgrades&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
