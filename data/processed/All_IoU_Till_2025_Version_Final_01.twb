    <worksheet name='Sheet 12'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' italic='true'>Summary of Electric Line Extension Applications and Energization by IOU Customer Class</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='IOU_2025_Incomplete+ (All_IoU_Till_2025)' name='federated.0drjc4v18r77ce0zve4l3116p43z' />
          </datasources>
          <datasource-dependencies datasource='federated.0drjc4v18r77ce0zve4l3116p43z'>
            <column caption='New Construction/Upgrade' datatype='string' name='[Calculation_2228437453904437248]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([Fuel_Structure_Type], &quot;New Construction&quot;) THEN &quot;New Construction&quot;&#13;&#10;ELSEIF CONTAINS([Fuel_Structure_Type], &quot;Upgrades&quot;) THEN &quot;Upgrades&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
            </column>
            <column caption='Fuel Type' datatype='string' name='[Calculation_2228437453907271682]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([Fuel_Structure_Type], &quot;All Electric&quot;) THEN &quot;All Electric&quot;&#13;&#10;ELSEIF CONTAINS([Fuel_Structure_Type], &quot;Mixed Fuel&quot;) THEN &quot;Mixed Fuel&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
            </column>
            <column caption='All+Mixed Count' datatype='real' name='[Calculation_2228437453907460099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(IF ([Calculation_2228437453907271682] = &quot;All Electric&quot; OR [Calculation_2228437453907271682] = &quot;Mixed Fuel&quot;) &#13;&#10;AND ([Type] = &quot;Total Electric Line or Service Extension Applications (IOU Installed)&quot; &#13;&#10;OR [Type] = &quot;Total Electric Line or Service Extension Applications (Applicant Installed)&quot;) &#13;&#10;THEN [Count] END)' />
            </column>
            <column caption='All Electric Count' datatype='real' name='[Calculation_2228437453908533252]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(IF [Calculation_2228437453907271682] = &quot;All Electric&quot; &#13;&#10;AND ([Type] = &quot;Total Electric Line or Service Extension Applications (IOU Installed)&quot; &#13;&#10;OR [Type] = &quot;Total Electric Line or Service Extension Applications (Applicant Installed)&quot;) &#13;&#10;THEN [Count] END)' />
            </column>
            <column caption='Total Electric Line Extension Applications' datatype='real' name='[Calculation_2228437453909241862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [Type] = &quot;Total Electric Line or Service Extension Applications (Applicant Installed)&quot; OR [Type] = &quot;Total Electric Line or Service Extension Applications (IOU Installed)&quot; THEN [Count]&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='Total Electric Line Extensions Energized' datatype='real' name='[Calculation_2228437453909647367]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;IF [Type] = &quot;Total Electric Line or Service Extensions Energized&quot; THEN [Count]&#13;&#10;END&#13;&#10;)' />
            </column>
            <column caption='Quarterly' datatype='datetime' datatype-customized='true' name='[Calculation_2228437453910351880]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&#13;&#10;    &apos;quarter&apos;,&#13;&#10;    MAKEDATE(&#13;&#10;        INT([Year]),&#13;&#10;        CASE LEFT(TRIM(LOWER([Month])),3)&#13;&#10;            WHEN &quot;jan&quot; THEN 1&#13;&#10;            WHEN &quot;feb&quot; THEN 2&#13;&#10;            WHEN &quot;mar&quot; THEN 3&#13;&#10;            WHEN &quot;apr&quot; THEN 4&#13;&#10;            WHEN &quot;may&quot; THEN 5&#13;&#10;            WHEN &quot;jun&quot; THEN 6&#13;&#10;            WHEN &quot;jul&quot; THEN 7&#13;&#10;            WHEN &quot;aug&quot; THEN 8&#13;&#10;            WHEN &quot;sep&quot; THEN 9&#13;&#10;            WHEN &quot;oct&quot; THEN 10&#13;&#10;            WHEN &quot;nov&quot; THEN 11&#13;&#10;            WHEN &quot;dec&quot; THEN 12&#13;&#10;        END,&#13;&#10;        1&#13;&#10;    )&#13;&#10;)' />
            </column>
            <column caption='Year-wise' datatype='string' datatype-customized='true' default-role='measure' default-type='quantitative' name='[Calculation_2391974352988409858]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([Year])' />
            </column>
            <column datatype='integer' name='[Climate Zone]' role='measure' type='quantitative' />
            <column datatype='real' name='[Count]' role='measure' type='quantitative' />
            <column datatype='string' name='[Customer Class]' role='dimension' type='nominal' />
            <column caption='Fuel Structure Type' datatype='string' name='[Fuel_Structure_Type]' role='dimension' type='nominal' />
            <column caption='Io U' datatype='string' name='[IoU]' role='dimension' type='nominal' />
            <column datatype='string' name='[Month]' role='dimension' type='nominal' />
            <column caption='Percent All‑Electric Applications' datatype='real' name='[Percent All Electric (copy)_2391974352985391105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_2228437453908533252])/(SUM({FIXED[IoU],[Calculation_2228437453910351880], [Year] : SUM([Calculation_2228437453907460099])}))*100' />
            </column>
            <column caption='Quarters' datatype='string' datatype-customized='true' name='[Quarterly (copy)_2391974352989208579]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE LOWER([Month])&#13;&#10;WHEN &quot;jan&quot; THEN &quot;Q1&quot;&#13;&#10;WHEN &quot;feb&quot; THEN &quot;Q1&quot;&#13;&#10;WHEN &quot;mar&quot; THEN &quot;Q1&quot;&#13;&#10;WHEN &quot;apr&quot; THEN &quot;Q2&quot;&#13;&#10;WHEN &quot;may&quot; THEN &quot;Q2&quot;&#13;&#10;WHEN &quot;jun&quot; THEN &quot;Q2&quot;&#13;&#10;WHEN &quot;jul&quot; THEN &quot;Q3&quot;&#13;&#10;WHEN &quot;aug&quot; THEN &quot;Q3&quot;&#13;&#10;WHEN &quot;sep&quot; THEN &quot;Q3&quot;&#13;&#10;WHEN &quot;oct&quot; THEN &quot;Q4&quot;&#13;&#10;WHEN &quot;nov&quot; THEN &quot;Q4&quot;&#13;&#10;WHEN &quot;dec&quot; THEN &quot;Q4&quot;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Type]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Year]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_2228437453904437248]' derivation='None' name='[none:Calculation_2228437453904437248:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2391974352988409858]' derivation='None' name='[none:Calculation_2391974352988409858:nk]' pivot='key' type='nominal' />
