      <column caption='Quarters' datatype='string' datatype-customized='true' name='[Quarterly (copy)_2391974352989208579]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE LOWER([Month])&#13;&#10;WHEN &quot;jan&quot; THEN &quot;Q1&quot;&#13;&#10;WHEN &quot;feb&quot; THEN &quot;Q1&quot;&#13;&#10;WHEN &quot;mar&quot; THEN &quot;Q1&quot;&#13;&#10;WHEN &quot;apr&quot; THEN &quot;Q2&quot;&#13;&#10;WHEN &quot;may&quot; THEN &quot;Q2&quot;&#13;&#10;WHEN &quot;jun&quot; THEN &quot;Q2&quot;&#13;&#10;WHEN &quot;jul&quot; THEN &quot;Q3&quot;&#13;&#10;WHEN &quot;aug&quot; THEN &quot;Q3&quot;&#13;&#10;WHEN &quot;sep&quot; THEN &quot;Q3&quot;&#13;&#10;WHEN &quot;oct&quot; THEN &quot;Q4&quot;&#13;&#10;WHEN &quot;nov&quot; THEN &quot;Q4&quot;&#13;&#10;WHEN &quot;dec&quot; THEN &quot;Q4&quot;&#13;&#10;END' />
