      <aliases enabled='yes' />
      <column caption='Agency Num' datatype='real' name='[AgencyNum]' role='dimension' type='ordinal' />
      <column caption='Calculation1' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_678636234282102784]) / TOTAL(SUM([Calculation_678636234282102784]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2228437453908533252]) / TOTAL(SUM([Calculation_2228437453908533252]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='Count Based Data Categories' datatype='string' datatype-customized='true' name='[Calculation_1246371198492864514]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Type], &quot;Number of Allowances&quot;) THEN &quot;Allowances (Count)&quot;&#13;&#10;ELSEIF CONTAINS([Type], &quot;Number of Discounts&quot;) THEN &quot;Discounts (Count)&quot;&#13;&#10;ELSEIF CONTAINS([Type], &quot;Number of Estimated&quot;) OR CONTAINS([Type], &quot;Number of Refund Payments&quot;) THEN &quot;Refunds (Count)&quot;&#13;&#10;ELSEIF CONTAINS([Type], &quot;Projects Energized&quot;) THEN &quot;Projects Energized&quot;&#13;&#10;ELSEIF CONTAINS([Type], &quot;Upgrades&quot;) THEN &quot;Upgrades&quot;&#13;&#10;ELSEIF CONTAINS([Type], &quot;Total Electric Line or Service Extension Applications&quot;) THEN &quot;Applications&quot;&#13;&#10;ELSEIF [Type] = &quot;Average of # of Days Between Full Payment and Project Energization&quot; THEN &quot;Cycle Time (Days)&quot;&#13;&#10;ELSE &quot;Other Count Data&quot;&#13;&#10;END' />
      </column>
      <column caption='Financial Data Category' datatype='string' name='[Calculation_1246371198559424516]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Type], &quot;Total Allowances (Exempted&quot;) THEN &quot;Allowances - Exempted&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS([Type], &quot;Total Allowances (Non-Exempted&quot;) THEN &quot;Allowances - Non-Exempted&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS([Type], &quot;Total Discounts (Exempted&quot;) THEN &quot;Discounts - Exempted&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS([Type], &quot;Total Discounts (Non-Exempted&quot;) THEN &quot;Discounts - Non-Exempted&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS([Type], &quot;Total Refund Payments Provided to Builders (Exempted&quot;) THEN &quot;Refund Payments Provided to Builders- Exempted&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS([Type], &quot;Total Refund Payments Provided to Builders (Non-Exempted&quot;) THEN &quot;Refund Payments Provided to Builders- Non-Exempted&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS([Type], &quot;Total Estimated Refundable&quot;) THEN &quot;Refunds - Estimated Refundable&quot;&#13;&#10;&#13;&#10;ELSEIF CONTAINS([Type], &quot;Total Estimated Non-Refundable&quot;) THEN &quot;Refunds - Estimated Non-Refundable&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='IoU_names' datatype='string' name='[Calculation_2077003854152032256]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Utility]&#13;&#10;WHEN &quot;Pacific Gas and Electric Company&quot; THEN &quot;PG&amp;E&quot;&#13;&#10;WHEN &quot;Southern California Edison Company&quot; THEN &quot;SCE&quot;&#13;&#10;WHEN &quot;San Diego Gas &amp; Electric Company&quot; THEN &quot;SDG&amp;E&quot;&#13;&#10;END' />
      </column>
      <column caption='New Construction/Upgrade' datatype='string' name='[Calculation_2228437453904437248]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Fuel_Structure_Type], &quot;New Construction&quot;) THEN &quot;New Construction&quot;&#13;&#10;ELSEIF CONTAINS([Fuel_Structure_Type], &quot;Upgrades&quot;) THEN &quot;Upgrades&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Electric Line Extension Application' datatype='string' name='[Calculation_2228437453905539073]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Type], &quot;Total Electric Line or Service Extension Applications (Applicant Installed)&quot;) THEN &quot;Applicant Installed&quot;&#13;&#10;ELSEIF CONTAINS([Type], &quot;Total Electric Line or Service Extension Applications (IOU Installed)&quot;)THEN &quot;IOU Installed&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Fuel Type' datatype='string' name='[Calculation_2228437453907271682]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Fuel_Structure_Type], &quot;All Electric&quot;) THEN &quot;All Electric&quot;&#13;&#10;ELSEIF CONTAINS([Fuel_Structure_Type], &quot;Mixed Fuel&quot;) THEN &quot;Mixed Fuel&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='All+Mixed Count' datatype='real' name='[Calculation_2228437453907460099]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(IF ([Calculation_2228437453907271682] = &quot;All Electric&quot; OR [Calculation_2228437453907271682] = &quot;Mixed Fuel&quot;) &#13;&#10;AND ([Type] = &quot;Total Electric Line or Service Extension Applications (IOU Installed)&quot; &#13;&#10;OR [Type] = &quot;Total Electric Line or Service Extension Applications (Applicant Installed)&quot;) &#13;&#10;THEN [Count] END)' />
      </column>
      <column caption='All Electric Count' datatype='real' name='[Calculation_2228437453908533252]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(IF [Calculation_2228437453907271682] = &quot;All Electric&quot; &#13;&#10;AND ([Type] = &quot;Total Electric Line or Service Extension Applications (IOU Installed)&quot; &#13;&#10;OR [Type] = &quot;Total Electric Line or Service Extension Applications (Applicant Installed)&quot;) &#13;&#10;THEN [Count] END)' />
      </column>
      <column caption='Percent All Electric' datatype='real' name='[Calculation_2228437453909094405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2228437453908533252])/(SUM({FIXED[IoU],[Calculation_2228437453910351880], [Year] : SUM([Calculation_2228437453907460099])}))*100' />
      </column>
      <column caption='Total Electric Line Extension Applications' datatype='real' name='[Calculation_2228437453909241862]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [Type] = &quot;Total Electric Line or Service Extension Applications (Applicant Installed)&quot; OR [Type] = &quot;Total Electric Line or Service Extension Applications (IOU Installed)&quot; THEN [Count]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Total Electric Line Extensions Energized' datatype='real' name='[Calculation_2228437453909647367]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [Type] = &quot;Total Electric Line or Service Extensions Energized&quot; THEN [Count]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Quarterly' datatype='datetime' datatype-customized='true' name='[Calculation_2228437453910351880]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&#13;&#10;    &apos;quarter&apos;,&#13;&#10;    MAKEDATE(&#13;&#10;        INT([Year]),&#13;&#10;        CASE LEFT(TRIM(LOWER([Month])),3)&#13;&#10;            WHEN &quot;jan&quot; THEN 1&#13;&#10;            WHEN &quot;feb&quot; THEN 2&#13;&#10;            WHEN &quot;mar&quot; THEN 3&#13;&#10;            WHEN &quot;apr&quot; THEN 4&#13;&#10;            WHEN &quot;may&quot; THEN 5&#13;&#10;            WHEN &quot;jun&quot; THEN 6&#13;&#10;            WHEN &quot;jul&quot; THEN 7&#13;&#10;            WHEN &quot;aug&quot; THEN 8&#13;&#10;            WHEN &quot;sep&quot; THEN 9&#13;&#10;            WHEN &quot;oct&quot; THEN 10&#13;&#10;            WHEN &quot;nov&quot; THEN 11&#13;&#10;            WHEN &quot;dec&quot; THEN 12&#13;&#10;        END,&#13;&#10;        1&#13;&#10;    )&#13;&#10;)' />
      </column>
      <column caption='Year-wise' datatype='string' datatype-customized='true' default-role='measure' default-type='quantitative' name='[Calculation_2391974352988409858]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([Year])' />
      </column>
      <column caption='Mixed Fuel Count' datatype='integer' name='[Calculation_678636234282102784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2228437453907271682] = &quot;Mixed Fuel&quot;&#13;&#10;AND (&#13;&#10;    [Type] = &quot;Total Electric Line or Service Extension Applications (IOU Installed)&quot;&#13;&#10;    OR [Type] = &quot;Total Electric Line or Service Extension Applications (Applicant Installed)&quot;&#13;&#10;)&#13;&#10;THEN INT([Count])&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Electric Line Extension Request' datatype='real' name='[Calculation_678636234317651970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Count]' />
      </column>
      <column caption='Fuel Structure Type' datatype='string' name='[Fuel_Structure_Type]' role='dimension' type='nominal' />
      <column caption='Hifld Id' datatype='string' name='[HIFLD_ID]' role='dimension' type='nominal' />
      <column caption='IOU' datatype='string' name='[IoU]' role='dimension' type='nominal' />
      <column caption='Online Name' datatype='string' name='[OnlineName]' role='dimension' type='nominal' />
      <column caption='Percent All‑Electric Applications' datatype='real' name='[Percent All Electric (copy)_2391974352985391105]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2228437453908533252])/(SUM({FIXED[IoU],[Calculation_2228437453910351880], [Year] : SUM([Calculation_2228437453907460099])}))*100' />
      </column>
      <column caption='Percent Mixed Fuel Applications ' datatype='real' name='[Percent All‑Electric Applications (copy)_2391974353008873478]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_678636234282102784])/(SUM({FIXED[IoU],[Calculation_2228437453910351880], [Year] : SUM([Calculation_2228437453907460099])}))*100' />
      </column>
      <column caption='Quarters' datatype='string' datatype-customized='true' name='[Quarterly (copy)_2391974352989208579]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE LOWER([Month])&#13;&#10;WHEN &quot;jan&quot; THEN &quot;Q1&quot;&#13;&#10;WHEN &quot;feb&quot; THEN &quot;Q1&quot;&#13;&#10;WHEN &quot;mar&quot; THEN &quot;Q1&quot;&#13;&#10;WHEN &quot;apr&quot; THEN &quot;Q2&quot;&#13;&#10;WHEN &quot;may&quot; THEN &quot;Q2&quot;&#13;&#10;WHEN &quot;jun&quot; THEN &quot;Q2&quot;&#13;&#10;WHEN &quot;jul&quot; THEN &quot;Q3&quot;&#13;&#10;WHEN &quot;aug&quot; THEN &quot;Q3&quot;&#13;&#10;WHEN &quot;sep&quot; THEN &quot;Q3&quot;&#13;&#10;WHEN &quot;oct&quot; THEN &quot;Q4&quot;&#13;&#10;WHEN &quot;nov&quot; THEN &quot;Q4&quot;&#13;&#10;WHEN &quot;dec&quot; THEN &quot;Q4&quot;&#13;&#10;END' />
      </column>
