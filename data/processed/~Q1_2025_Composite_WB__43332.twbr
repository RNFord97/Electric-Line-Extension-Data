      <aliases enabled='yes' />
      <column caption='Total ELE Applications' datatype='integer' name='[Calculation_1233704853081579520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Total Electric Line Extension Applications (Applicant Installed)]+[Total Electric Line Extension Applications (IOU Installed)]' />
      </column>
      <column caption='All + Mixed' datatype='integer' name='[Calculation_1233704853094031362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Mixed Fuel / All Electric] = &quot;All Electric&quot; OR [Mixed Fuel / All Electric] = &quot;Mixed Fuel&quot; THEN [Calculation_1233704853081579520] END' />
      </column>
      <column caption='All Electric' datatype='integer' name='[Calculation_1233704853097250821]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Mixed Fuel / All Electric] = &quot;All Electric&quot; THEN [Calculation_1233704853081579520] END' />
      </column>
      <column caption='Percent All Electric' datatype='real' name='[Calculation_1233704853098008582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1233704853097250821]) / SUM([Calculation_1233704853094031362])*100' />
      </column>
      <column datatype='string' name='[Customer Class]' role='dimension' type='nominal' />
